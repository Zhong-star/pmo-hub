{
  "openapi": "3.0.0",
  "paths": {
    "/api/lessons-learned/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Check Lessons Learned API availability",
        "tags": [
          "Lessons Learned health"
        ]
      }
    },
    "/api/lessons-learned/v1/home": {
      "get": {
        "operationId": "HomeController_getHome",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonsLearnedHomeResponse"
                }
              }
            }
          },
          "401": {
            "description": "A local Hub profile must be selected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalAccessProblem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "example": "LocalProfile realm=\"Lessons Learned\""
                }
              }
            }
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalAccessProblem"
                }
              }
            }
          },
          "500": {
            "description": "The Lessons Learned local access configuration is invalid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalAccessProblem"
                }
              }
            }
          },
          "503": {
            "description": "Local simulated identity is disabled for this runtime.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalAccessProblem"
                }
              }
            }
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "Revalidate local access and return the authorized Lessons Learned Home",
        "tags": [
          "Lessons Learned home"
        ]
      }
    },
    "/api/lessons-learned/v1/lessons": {
      "post": {
        "operationId": "LessonsController_createDraft",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLessonRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonDraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "The title must contain 1 to 150 characters."
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          },
          "503": {
            "description": "Lessons Learned persistence is unavailable."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "Create a title-only Open lesson draft for the selected profile",
        "tags": [
          "Lessons"
        ]
      },
      "get": {
        "operationId": "LessonsController_getMyOpenDrafts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LessonDraftResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          },
          "503": {
            "description": "Lessons Learned persistence is unavailable."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "List the selected profile’s Open lesson drafts",
        "tags": [
          "Lessons"
        ]
      }
    },
    "/api/lessons-learned/v1/lessons/projects": {
      "get": {
        "operationId": "LessonsController_getProjects",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LessonProjectResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "List fictional local projects available for lesson drafts",
        "tags": [
          "Lessons"
        ]
      }
    },
    "/api/lessons-learned/v1/lessons/mine": {
      "get": {
        "operationId": "LessonsController_getMySubmissions",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Title prefix or exact numeric lesson ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "required": false,
            "in": "query",
            "description": "Project snapshot ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "withoutProject",
            "required": false,
            "in": "query",
            "description": "Filter to lessons without a project.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lessonType",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "Future Prevention",
                "Success to Repeat",
                "Risk Avoided",
                "Communication"
              ],
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "Open",
                "PMOEvaluation",
                "Approved",
                "Closed",
                "Archived"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LessonDraftResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          },
          "503": {
            "description": "Lessons Learned persistence is unavailable."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "List the selected profile’s own submissions across all statuses",
        "tags": [
          "Lessons"
        ]
      }
    },
    "/api/lessons-learned/v1/lessons/{id}": {
      "get": {
        "operationId": "LessonsController_getOwnLessonDetails",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The numeric ID of the lesson.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonDetailsResponse"
                }
              }
            }
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          },
          "404": {
            "description": "The lesson does not exist or is not owned by the selected profile."
          },
          "503": {
            "description": "Lessons Learned persistence is unavailable."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "Get an author-owned lesson and its lifecycle history",
        "tags": [
          "Lessons"
        ]
      },
      "patch": {
        "operationId": "LessonsController_updateOwnOpenDraft",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The numeric ID of the lesson draft.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLessonDraftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonDraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "The draft fields or project selection are invalid."
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          },
          "404": {
            "description": "The lesson does not exist or is not owned by the selected profile."
          },
          "409": {
            "description": "The draft changed after it was loaded or is no longer Open.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonConflictResponse"
                }
              }
            }
          },
          "503": {
            "description": "Lessons Learned persistence is unavailable."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "Update an author-owned Open lesson draft using its expected version",
        "tags": [
          "Lessons"
        ]
      }
    },
    "/api/lessons-learned/v1/lessons/{id}/submit": {
      "post": {
        "operationId": "LessonsController_submitOwnOpenDraft",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The numeric ID of the lesson draft.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitLessonRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonDraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "Submission fields are invalid; fieldErrors identifies the fields to correct.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonSubmissionValidationResponse"
                }
              }
            }
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          },
          "404": {
            "description": "The lesson does not exist or is not owned by the selected profile."
          },
          "409": {
            "description": "The lesson is no longer Open or the submitted version is stale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonConflictResponse"
                }
              }
            }
          },
          "503": {
            "description": "Lessons Learned persistence is unavailable."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "Submit a complete author-owned Open lesson for PMO evaluation",
        "tags": [
          "Lessons"
        ]
      }
    },
    "/api/lessons-learned/v1/lessons/{id}/cancel": {
      "post": {
        "operationId": "LessonsController_cancelOwnOpenDraft",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The numeric ID of the lesson draft.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelLessonRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonDraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "The cancellation reason is invalid; fieldErrors identifies the field to correct.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonCancellationValidationResponse"
                }
              }
            }
          },
          "401": {
            "description": "A local Hub profile must be selected."
          },
          "403": {
            "description": "The selected profile has no active Lessons Learned access."
          },
          "404": {
            "description": "The lesson does not exist or is not owned by the selected profile."
          },
          "409": {
            "description": "The lesson is no longer Open or the cancelled version is stale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonConflictResponse"
                }
              }
            }
          },
          "503": {
            "description": "Lessons Learned persistence is unavailable."
          }
        },
        "security": [
          {
            "localProfile": []
          }
        ],
        "summary": "Cancel an author-owned Open lesson with a reason",
        "tags": [
          "Lessons"
        ]
      }
    }
  },
  "info": {
    "title": "Lessons Learned API",
    "description": "Local access, Home, and draft registration endpoints for the Lessons Learned module.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "localProfile": {
        "type": "apiKey",
        "in": "header",
        "name": "X-PMO-Local-User-ID",
        "description": "Simulated local Hub profile ID. The API resolves the module role."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "LocalAccessProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlationId"
        ]
      },
      "LessonsLearnedProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "local-contributor"
          },
          "displayName": {
            "type": "string",
            "example": "Local Contributor"
          },
          "role": {
            "type": "string",
            "enum": [
              "LESSONS_USER",
              "LESSONS_MODERATOR"
            ],
            "example": "LESSONS_USER"
          }
        },
        "required": [
          "id",
          "displayName",
          "role"
        ]
      },
      "LessonsLearnedNavigationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "home"
          },
          "label": {
            "type": "string",
            "example": "Home"
          },
          "current": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "label",
          "current"
        ]
      },
      "LessonsLearnedHomeResponse": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/LessonsLearnedProfile"
          },
          "navigation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LessonsLearnedNavigationItem"
            }
          }
        },
        "required": [
          "profile",
          "navigation"
        ]
      },
      "CreateLessonRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "example": "Improve release handover"
          },
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "nullable": true
          },
          "projectName": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "projectCategory": {
            "type": "string",
            "enum": [
              "Technology",
              "Business",
              "Infrastructure",
              "Data"
            ],
            "nullable": true
          },
          "projectPhase": {
            "type": "string",
            "enum": [
              "Initiation",
              "Planning",
              "Execution",
              "Closure",
              "Not Applicable"
            ],
            "nullable": true
          },
          "situationObserved": {
            "type": "string",
            "maxLength": 4000,
            "nullable": true
          },
          "rootCause": {
            "type": "string",
            "maxLength": 4000,
            "nullable": true
          },
          "lessonType": {
            "type": "string",
            "enum": [
              "Future Prevention",
              "Success to Repeat",
              "Risk Avoided",
              "Communication"
            ],
            "nullable": true
          },
          "impact": {
            "type": "string",
            "maxLength": 4000,
            "nullable": true
          },
          "recommendation": {
            "type": "string",
            "maxLength": 4000,
            "nullable": true
          },
          "applicability": {
            "type": "string",
            "maxLength": 4000,
            "nullable": true
          }
        },
        "required": [
          "title"
        ]
      },
      "LessonDraftResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "maxLength": 150,
            "example": "Improve release handover"
          },
          "authorId": {
            "type": "string",
            "example": "local-contributor"
          },
          "updatedBy": {
            "type": "string",
            "example": "local-contributor"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "PMOEvaluation",
              "Approved",
              "Closed",
              "Archived"
            ],
            "example": "Open"
          },
          "version": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "projectId": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "projectName": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "projectCategory": {
            "type": "string",
            "enum": [
              "Technology",
              "Business",
              "Infrastructure",
              "Data"
            ],
            "nullable": true
          },
          "projectPhase": {
            "type": "string",
            "enum": [
              "Initiation",
              "Planning",
              "Execution",
              "Closure",
              "Not Applicable"
            ],
            "nullable": true
          },
          "situationObserved": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "rootCause": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "lessonType": {
            "type": "string",
            "enum": [
              "Future Prevention",
              "Success to Repeat",
              "Risk Avoided",
              "Communication"
            ],
            "nullable": true
          },
          "impact": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "recommendation": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "applicability": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "authorId",
          "updatedBy",
          "status",
          "version",
          "projectId",
          "projectName",
          "projectCategory",
          "projectPhase",
          "situationObserved",
          "rootCause",
          "lessonType",
          "impact",
          "recommendation",
          "applicability",
          "createdAt",
          "updatedAt"
        ]
      },
      "LessonProjectResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "LOCAL-PROJECT-001"
          },
          "name": {
            "type": "string",
            "example": "Fictional Atlas Modernization"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "LessonHistoryEventResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "actorId": {
            "type": "string"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "Created",
              "Submitted",
              "Cancelled"
            ]
          },
          "previousStatus": {
            "type": "string",
            "enum": [
              "Open",
              "PMOEvaluation",
              "Approved",
              "Closed",
              "Archived"
            ],
            "nullable": true
          },
          "newStatus": {
            "type": "string",
            "enum": [
              "Open",
              "PMOEvaluation",
              "Approved",
              "Closed",
              "Archived"
            ]
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "actorId",
          "eventType",
          "previousStatus",
          "newStatus",
          "reason",
          "occurredAt"
        ]
      },
      "LessonDetailsResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "maxLength": 150,
            "example": "Improve release handover"
          },
          "authorId": {
            "type": "string",
            "example": "local-contributor"
          },
          "updatedBy": {
            "type": "string",
            "example": "local-contributor"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "PMOEvaluation",
              "Approved",
              "Closed",
              "Archived"
            ],
            "example": "Open"
          },
          "version": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "projectId": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "projectName": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "projectCategory": {
            "type": "string",
            "enum": [
              "Technology",
              "Business",
              "Infrastructure",
              "Data"
            ],
            "nullable": true
          },
