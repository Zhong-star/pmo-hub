{
  "name": "@pmo-hub/hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "openapi:types": "openapi-typescript ../../services/hub-api/openapi/hub-v1.json -o src/generated/hub-api.d.ts",
    "test": "vitest run",
    "test:e2e": "npm run build --workspace @pmo-hub/hub-api && playwright test",
    "test:e2e:lessons-learned": "node ../../services/lessons-learned-api/run-playwright-e2e.mjs",
    "test:e2e:lessons-learned:registration": "node ../../services/lessons-learned-api/run-playwright-e2e.mjs --grep \"Contributor creates a title-only lesson and completes it\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "openapi-typescript": "^7.10.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
